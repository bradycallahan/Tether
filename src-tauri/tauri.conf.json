{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tether",
  "version": "0.3.0",
  "identifier": "dev.tether.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tether",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 420,
        "label": "main",
        "center": true,
        "visible": false,
        "backgroundColor": "#171b20",
        "dragDropEnabled": false,
        "scrollBarStyle": "fluentOverlay",
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Open-source terminal for SSH, Telnet, serial and local shells",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Brady Callahan",
    "copyright": "Copyright © 2026 Brady Callahan. MIT License.",
    "homepage": "https://github.com/bradycallahan/Tether",
    "longDescription": "Tether is an open-source terminal for network and systems administrators: SSH, Telnet, raw TCP, serial consoles and local shells, with a saved-session library.",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/header.bmp",
        "sidebarImage": "icons/installer/sidebar.bmp",
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
